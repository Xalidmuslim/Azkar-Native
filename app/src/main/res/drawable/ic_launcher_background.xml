<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9D0BF" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <bitmap
            android:src="@drawable/azkar_launcher_art"
            android:gravity="fill"
            android:antialias="true"
            android:filter="true" />
    </item>
</layer-list>
